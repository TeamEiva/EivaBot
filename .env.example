# EivaBot environment configuration
# Copy this file to `.env` (or set these variables on your hosting platform)
# and fill in real values. NEVER commit a real .env or session string.

# --- Required: Telegram API credentials (https://my.telegram.org) ---
APP_ID=12345
API_HASH=0123456789abcdef0123456789abcdef

# --- Required: Telethon StringSession (generate with `python stringsetup.py`) ---
EivaBOT_SESSION=

# --- Optional: logging channel (must start with -100) ---
LOGGER_ID=

# --- Optional: helper bot (from @BotFather) ---
BOT_TOKEN=
BOT_USERNAME=

# --- Optional: behaviour toggles ---
HANDLER=.
PM_PERMIT=ENABLE
ABUSE=OFF
SUDO_USERS=

# --- Optional: Heroku updater ---
HEROKU_API_KEY=
HEROKU_APP_NAME=

# --- Optional: database ---
MONGO_DB_URL=
DATABASE_URL=
