#!/bin/bash
# EivaBot launcher: fetches the latest EivaBot core package, installs any new
# requirements, and starts the userbot.
#
# Optional environment variables:
#   Eiva_REPO        - "EivaBot" / "Eivabot" (default upstream) or a full
#                      https://github.com/owner/repo URL for a custom fork.
#   Eiva_REPO_BRANCH - branch to pull when using a custom repo URL (default: main).

set -euo pipefail

DEFAULT_REPO_ZIP="https://github.com/TeamEiva/Eiva-Userbot/archive/main.zip"

_repolink () {
    local regex='(https?)://github\.com/[^/]+/[^/]+'
    case "${Eiva_REPO:-EivaBot}" in
        EivaBot|Eivabot)
            echo "$DEFAULT_REPO_ZIP"
            ;;
        *$regex*|https://github.com/*|http://github.com/*)
            if [[ -n "${Eiva_REPO_BRANCH:-}" ]]
            then
                echo "${Eiva_REPO}/archive/${Eiva_REPO_BRANCH}.zip"
            else
                echo "${Eiva_REPO}/archive/main.zip"
            fi
            ;;
        *)
            echo "$DEFAULT_REPO_ZIP"
            ;;
    esac
}

start_bot () {
    local zippath="myEivabot.zip"
    local repolink
    repolink=$(_repolink)

    echo "  Downloading source code ..."
    wget -q "$repolink" -O "$zippath"

    echo "  Unpacking data ..."
    local EivaPATH
    EivaPATH=$(zipinfo -1 "$zippath" | grep -v '/\.' | head -n1)
    unzip -oqq "$zippath"
    rm -f "$zippath"

    cd "$EivaPATH"

    echo "  Installing requirements ..."
    python3 -m pip install --upgrade -r requirements.txt

    echo "  Starting EivaBot ..."
    exec python3 -m Eivabot
}

start_bot
